rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == 'hwvu4siXbGhcpbreCQfca6b1P0h1';
    }

    match /stories/audio/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /stories/covers/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /podcasts/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
