rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && (
          request.auth.uid == 'XENByyR5dOY1i0NqI0ridlEmVc23'
          || (
            request.auth.token.email != null 
            && request.auth.token.email == 'joydas.21071997@gmail.com'
            && request.auth.token.email_verified == true
          )
          || (
            request.auth.token.role == 'admin'
            || request.auth.token.role == 'super_admin'
          )
        );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // ১. গল্পের কালেকশন (Stories): Public read, Admin write
    match /stories/{storyId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      // ২. গল্পের রিভিউ সাব-কালেকশন (Story Reviews)
      // Path: stories/{storyId}/reviews/{reviewId} (reviewId is the user's Auth UID)
      // Normal user may create/update/delete only their own review. Anonymous reviews forbidden.
      match /reviews/{reviewId} {
        allow read: if true;
        allow create, update, delete: if isAuthenticated() && (request.auth.uid == reviewId || isAdmin());
      }

      // গল্প সংক্রান্ত চ্যাপ্টার বা পর্ব (Episodes)
      match /episodes/{episodeId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // ২(খ). ধারাবাহিক অডিও সিরিজ ও এপিসোড (Series & Episodes)
    // Public read, Admin write only
    match /series/{seriesId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /episodes/{episodeId} {
        allow read: if true;
        allow create, update, delete: if isAdmin();
      }
    }

    // সিস্টেম নোটিফিকেশন লগ (System Notifications)
    match /system_notifications/{notifId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // ৩. ব্যবহারকারীদের প্রোফাইল ও ডেটা (Users, Bookmarks, History)
    // User can read their own profile; Admin can read/manage all user profiles
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      
      // Prevent user privilege escalation on create
      allow create: if isAdmin() || (
        isOwner(userId)
        && (!('role' in request.resource.data) || (request.resource.data.role != 'admin' && request.resource.data.role != 'super_admin'))
        && (!('subscriptionStatus' in request.resource.data) || request.resource.data.subscriptionStatus == 'inactive')
        && (!('hasTwentyTakaPass' in request.resource.data) || request.resource.data.hasTwentyTakaPass != true)
      );

      // Prevent user privilege escalation on update (cannot self-grant pass, admin role, or unlocked IDs)
      allow update: if isAdmin() || (
        isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'role',
          'subscriptionStatus',
          'subscriptionExpiry',
          'hasTwentyTakaPass',
          'unlockedStoryIds',
          'unlockedEpisodeIds'
        ])
      );

      allow delete: if isAdmin();

      // ইউজার সাব-কালেকশন (বুকমার্কস, হিস্ট্রি, ফেভারিটস, পুশ টোকেন)
      match /{subcollection}/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // ৪. অনুমোদিত অ্যাডমিন ইউজার তালিকা (Admin Users): Admin only
    match /admin_users/{adminId} {
      allow read, write: if isAdmin();
    }

    // ৫. শ্রোতাদের ইনবক্স ও যোগাযোগ বার্তা (Contact Messages)
    // Public create (cannot inject privileged status), Admin read/update/delete
    match /contact_messages/{messageId} {
      allow create: if isValidId(messageId)
        && (!('status' in request.resource.data) || request.resource.data.status in ['unread', 'pending'])
        && (!('role' in request.resource.data));
      allow read, update, delete: if isAdmin();
    }

    // ৬. পেমেন্ট ও লেনদেন (Payment Transactions)
    // User can create their own transaction, user can read only their own transaction,
    // user cannot modify payment status; Admin manages all transactions.
    match /transactions/{transactionId} {
      allow create: if (isAuthenticated() && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'pending') || isAdmin();
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ৭. সাবস্ক্রাইবার ও সিআরএম লিড (Subscribers & Leads)
    // Public/user creation allowed with pending status; normal users cannot read; Admin manages records
    match /subscribers/{subscriberId} {
      allow create: if (!('verificationStatus' in request.resource.data) || request.resource.data.verificationStatus in ['pending_verification', 'pending'])
        && (!('role' in request.resource.data))
        && (!('admin' in request.resource.data));
      allow read, update, delete: if isAdmin();
    }

    // ৮. কথক অডিশন ও আবেদন (Narrator Applications)
    // Public create (strictly pending, no approval code injection), Admin read/update/delete
    match /narrator_applications/{appId} {
      allow create: if isValidId(appId)
        && (!('status' in request.resource.data) || request.resource.data.status == 'pending')
        && (!('approvalCode' in request.resource.data));
      allow read, update, delete: if isAdmin();
    }

    // ৯. মানুষের জীবনের গল্প (Life Stories Submissions)
    // Public create (strictly new status), Admin read/update/delete
    match /life_stories/{storyId} {
      allow create: if isValidId(storyId)
        && (!('status' in request.resource.data) || request.resource.data.status == 'new');
      allow read, update, delete: if isAdmin();
    }

    // ১০. পডকাস্ট এপিসোড (Podcast Episodes)
    // Public read, Admin write
    match /podcast_episodes/{episodeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ১১. সিস্টেম ও ইউপিআই সেটিংস (System Settings)
    // about_mission is public read for the About & Team info; upi_config and others are Admin-only
    match /system_settings/{settingId} {
      allow read: if settingId == 'about_mission' || isAdmin();
      allow write: if isAdmin();
    }

    // ১২. অ্যাডমিন অ্যাক্টিভিটি লগ (Admin Activity Logs): Admin-only
    match /admin_activity_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
