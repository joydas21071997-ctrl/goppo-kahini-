rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny-all catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // STRICT ANTI-FAKE ACCOUNT BACKEND LOCK:
    // Only users whose email has been verified through Firebase Authentication
    function isVerifiedUser() {
      return isAuthenticated() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isSuperAdminEmail() {
      return request.auth.token.email == 'joydas.21071997@gmail.com';
    }

    function isGrantedAdmin() {
      return (request.auth.token.email != null && request.auth.token.email != 'joyfulfilms21@gmail.com' && exists(/databases/$(database)/documents/admin_users/$(request.auth.token.email)))
          || (request.auth.uid != null && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)));
    }

    // Hardened admin check strictly enforcing verified email matching owner or granted admin
    function isAdmin() {
      return isAuthenticated()
        && request.auth.token.email != 'joyfulfilms21@gmail.com'
        && (isSuperAdminEmail() || (request.auth.token.email_verified == true && isGrantedAdmin()));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User document path: users/{userId}
    match /users/{userId} {
      // Temporarily allow read to inspect UID
      allow read: if true;

      // Only verified users can create their own profile document
      // Strictly binds email and uid to authenticated token, preventing fake account creation in Firestore
      allow create: if isOwner(userId)
                    && isValidId(userId)
                    && request.resource.data.uid == userId
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.emailVerified == true
                    && request.resource.data.subscriptionStatus == 'inactive'
                    && request.resource.data.subscriptionExpiry == null;

      // Users can update only non-sensitive profile fields (displayName, photoURL, phoneNumber, updatedAt)
      // Subscription state & ownership cannot be spoofed by client; Admin has full control
      allow update: if (
                      isOwner(userId)
                      && request.resource.data.uid == resource.data.uid
                      && request.resource.data.email == resource.data.email
                      && (!('createdAt' in resource.data) || request.resource.data.createdAt == resource.data.createdAt)
                      && request.resource.data.subscriptionStatus == resource.data.subscriptionStatus
                      && request.resource.data.subscriptionExpiry == resource.data.subscriptionExpiry
                    ) || isAdmin();

      // Only verified Admin can delete user documents
      allow delete: if isAdmin();
    }

    // Audio Stories collection: stories/{storyId}
    match /stories/{storyId} {
      // Anyone (visitors and registered audience) can read story metadata and play audio
      allow read: if true;

      // Only verified Admin (joydas.21071997@gmail.com) can create, update, or delete audio stories
      allow write: if isAdmin();
    }

    // User favorites & listening history subcollections
    match /users/{userId}/favorites/{storyId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    match /users/{userId}/history/{historyId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Transactions and payment subscriptions
    match /transactions/{transactionId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isVerifiedUser() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /subscriptions/{subscriptionId} {
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Explicitly managed administrators & role delegation
    match /admin_users/{adminId} {
      allow read: if true;
      allow write: if isAuthenticated() && isSuperAdminEmail();
    }
  }
}
