rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && (
          request.auth.uid == 'XENByyR5dOY1i0NqI0ridlEmVc23'
          || (
            request.auth.token.email != null 
            && request.auth.token.email == 'joydas.21071997@gmail.com'
            && request.auth.token.email_verified == true
          )
          || (
            request.auth.token.role == 'admin'
            || request.auth.token.role == 'super_admin'
          )
        );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // ১. গল্পের কালেকশন (Stories): Public read, Admin write
    match /stories/{storyId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      // ২. গল্পের রিভিউ সাব-কালেকশন (Story Reviews)
      // Path: stories/{storyId}/reviews/{reviewId} (reviewId is the user's Auth UID)
      // Normal user may create/update/delete only their own review. Anonymous reviews forbidden.
      match /reviews/{reviewId} {
        allow read: if true;
        allow create, update, delete: if isAuthenticated() && (request.auth.uid == reviewId || isAdmin());
      }

      // গল্প সংক্রান্ত চ্যাপ্টার বা পর্ব (Episodes)
      match /episodes/{episodeId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // ৩. ব্যবহারকারীদের প্রোফাইল ও ডেটা (Users, Bookmarks, History)
    // User can read/write their own profile; Admin can read/manage user profiles
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      // ইউজার সাব-কালেকশন (বুকমার্কস, হিস্ট্রি, ফেভারিটস)
      match /{subcollection}/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // ৪. অনুমোদিত অ্যাডমিন ইউজার তালিকা (Admin Users): Admin only
    match /admin_users/{adminId} {
      allow read, write: if isAdmin();
    }

    // ৫. শ্রোতাদের ইনবক্স ও যোগাযোগ বার্তা (Contact Messages)
    // Public create, Admin read/update/delete
    match /contact_messages/{messageId} {
      allow create: if isValidId(messageId);
      allow read, update, delete: if isAdmin();
    }

    // ৬. পেমেন্ট ও লেনদেন (Payment Transactions)
    // User can create their own transaction, user can read only their own transaction,
    // user cannot modify payment status; Admin manages all transactions.
    match /transactions/{transactionId} {
      allow create: if (isAuthenticated() && request.resource.data.userId == request.auth.uid && request.resource.data.status == 'pending') || isAdmin();
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ৭. সাবস্ক্রাইবার ও সিআরএম লিড (Subscribers & Leads)
    // Public/user creation allowed; normal users cannot read; Admin manages records
    match /subscribers/{subscriberId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ৮. কথক অডিশন ও আবেদন (Narrator Applications)
    // Public create, Admin read/update/delete
    match /narrator_applications/{appId} {
      allow create: if isValidId(appId);
      allow read, update, delete: if isAdmin();
    }

    // ৯. মানুষের জীবনের গল্প (Life Stories Submissions)
    // Public create, Admin read/update/delete
    match /life_stories/{storyId} {
      allow create: if isValidId(storyId);
      allow read, update, delete: if isAdmin();
    }

    // ১০. পডকাস্ট এপিসোড (Podcast Episodes)
    // Public read, Admin write
    match /podcast_episodes/{episodeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ১১. সিস্টেম ও ইউপিআই সেটিংস (System Settings): Admin-only
    match /system_settings/{settingId} {
      allow read, write: if isAdmin();
    }

    // ১২. অ্যাডমিন অ্যাক্টিভিটি লগ (Admin Activity Logs): Admin-only
    match /admin_activity_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
